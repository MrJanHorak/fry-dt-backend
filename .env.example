# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=3001

# Frontend origin allowed by CORS and Socket.IO (e.g. https://your-app.netlify.app)
CLIENT_URL=http://localhost:3000

# MongoDB connection string
MONGO_DB=mongodb://127.0.0.1:27017/fry-dt

# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET=change-me

# Token lifetime (default 12h, about one school day)
JWT_EXPIRATION=12h

# bcrypt cost factor (default 12)
BCRYPT_ROUNDS=12

# Sign-in attempts per IP per 15 minutes (a classroom shares one IP)
LOGIN_RATE_LIMIT=100

# Set to true when running behind a reverse proxy (Railway, Render, Heroku, nginx)
TRUST_PROXY=true

# Optional: "Say it" speech model for devices without built-in on-device
# recognition (e.g. Chromebooks). Run `npm run fetch:vosk-model` in your
# build step; it downloads ~40 MB once and this server hosts it at /models.
# Pin the download after the first run with the SHA-256 it prints:
# VOSK_MODEL_SHA256=
# VOSK_MODEL_SOURCE_URL=https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip
